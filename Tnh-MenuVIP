local AntiHitConnection, AntiHitForce, AntiHitLoop

local function ApplyAntiHit()
    local c = LP.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not c or not h then return end

    if AntiHitForce and AntiHitForce.Parent ~= c then AntiHitForce = nil end
    if not AntiHitForce then
        AntiHitForce = Instance.new("ForceField")
        AntiHitForce.Name = "TnhVN_AntiHit"
        AntiHitForce.Visible = false
        AntiHitForce.Parent = c
    end

    if AntiHitLoop then AntiHitLoop:Disconnect() end
    AntiHitLoop = RunService.Heartbeat:Connect(function()
        if not S.AntiHit then return end
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    end)
end

local function StopAntiHit()
    if AntiHitConnection then AntiHitConnection:Disconnect() AntiHitConnection = nil end
    if AntiHitLoop then AntiHitLoop:Disconnect() AntiHitLoop = nil end
    if AntiHitForce then AntiHitForce:Destroy() AntiHitForce = nil end
end

local function StartAntiHit()
    StopAntiHit()
    S.AntiHit = true
    ApplyAntiHit()
    AntiHitConnection = LP.CharacterAdded:Connect(function()
        task.wait(.5)
        if S.AntiHit then ApplyAntiHit() end
    end)
end

