local FixHeader = PageHeader(FixPage, "FixLag", "Performance utilities")
local Saved = {}
local FixConnection

local function DisableEffect(o)
    if o:IsA("ParticleEmitter")
    or o:IsA("Trail")
    or o:IsA("Beam")
    or o:IsA("Smoke")
    or o:IsA("Fire")
    or o:IsA("Sparkles")
    or o:IsA("PointLight")
    or o:IsA("SpotLight")
    or o:IsA("SurfaceLight") then
        if Saved[o] == nil then Saved[o] = o.Enabled end
        pcall(function() o.Enabled = false end)
    end
end

local function StartFix()
    S.FixLag = true
    for _, o in ipairs(Workspace:GetDescendants()) do DisableEffect(o) end
    pcall(function()
        Saved.GlobalShadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
    end)
    pcall(function()
        if Workspace.StreamingEnabled then
            Saved.StreamingTargetRadius = Workspace.StreamingTargetRadius
            Workspace.StreamingTargetRadius = 300
        end
    end)
    FixConnection = Workspace.DescendantAdded:Connect(function(o)
        if S.FixLag then DisableEffect(o) end
    end)
end

local function StopFix()
    S.FixLag = false
    if FixConnection then FixConnection:Disconnect() FixConnection = nil end
    for o, v in pairs(Saved) do
        if typeof(o) == "Instance" and o.Parent then
            pcall(function() o.Enabled = v end)
        end
    end
    pcall(function()
        if Saved.GlobalShadows ~= nil then Lighting.GlobalShadows = Saved.GlobalShadows end
        if Saved.StreamingTargetRadius ~= nil then
            Workspace.StreamingTargetRadius = Saved.StreamingTargetRadius
        end
    end)
    Saved = {}
end

local XT = Toggle(FixPage, T("fixlag"), T("fixlagDesc"), function(v)
    if v then StartFix() else StopFix() end
end)

