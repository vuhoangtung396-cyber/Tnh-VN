-- AUTO STEAL EGG (SỬA HOÀN TOÀN - DÙNG HUMANOID:MOVE)
-- ==================================================
local AutoStealConnection
local AutoStealTarget = nil
local MyBasePosition = nil

-- Lấy vị trí base của người chơi (nơi có Pen/Base)
local function GetMyBase()
    -- Tìm base của người chơi trong Workspace
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            if obj.Name:lower():find(LP.Name:lower()) then
                local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if primary then return primary.Position end
            end
        end
    end
    -- Fallback: tìm "Base" hoặc "Pen"
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj.Name:lower():find("base") or obj.Name:lower():find("pen") then
            local primary = obj:FindFirstChildWhichIsA("BasePart")
            if primary then return primary.Position end
        end
    end
    return nil
end

-- Tìm Egg gần nhất trong tất cả Biome
local function FindNearestEgg(prioritySecret)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local allEggs = ScanAllEggs()
    if #allEggs == 0 then return nil end

    local best = nil
    local bestScore = -math.huge

    for _, egg in ipairs(allEggs) do
        if egg.part and egg.part.Parent then
            local dist = (egg.part.Position - root.Position).Magnitude
            local data = egg.data or {}
            
            -- Tính điểm ưu tiên
            local score = 0
            -- Ưu tiên Secret
            if prioritySecret then
                if data.rarity == "Secret" or data.rarity == "Mythic" or data.rarity == "Cosmic" or data.rarity == "Divine" or data.rarity == "Eternal" then
                    score = score + 1000000
                end
            end
            -- Ưu tiên theo giá trị (đảo ngược khoảng cách)
            local val = tonumber((data.income or "$0"):gsub("[^%d%.]", "")) or 0
            score = score + val * 1000
            score = score - dist
            
            if score > bestScore then
                bestScore = score
                best = egg
            end
        end
    end
    return best
end

local function StartAutoSteal()
    S.AutoSteal = true
    StatusLabel.Text = T("status") .. ": " .. T("statusOn")
    StatusLabel.TextColor3 = Color3.fromRGB(0, 220, 100)

    -- Lấy base position một lần
    MyBasePosition = GetMyBase()

    if AutoStealConnection then AutoStealConnection:Disconnect() end

    AutoStealConnection = RunService.Heartbeat:Connect(function()
        if not S.AutoSteal then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        -- Nếu đang cầm Egg, chạy về base
        local carryingEgg = false
        for _, obj in ipairs(char:GetChildren()) do
            if obj.Name:lower():find("egg") then carryingEgg = true break end
        end

        if carryingEgg then
            -- Chạy về base
            if MyBasePosition then
                local dir = (MyBasePosition - root.Position)
                if dir.Magnitude > 10 then
                    local move = dir.Unit
                    hum:Move(move, false)
                    StatusLabel.Text = T("status") .. ": Đang mang Egg về Base..."
                else
                    StatusLabel.Text = T("status") .. ": Đã về Base!"
                end
            else
                StatusLabel.Text = T("status") .. ": Không tìm thấy Base!"
            end
        else
            -- Tìm Egg gần nhất
            local target = FindNearestEgg(S.PrioritySecret)
            if target then
                AutoStealTarget = target
                local targetPos = target.part.Position
                local dir = (targetPos - root.Position)
                
                if dir.Magnitude > 5 then
                    local move = dir.Unit
                    hum:Move(move, false)
                    local data = target.data or {}
                    StatusLabel.Text = T("status") .. ": → " .. target.name .. " (" .. (data.income or "?") .. ")"
                else
                    StatusLabel.Text = T("status") .. ": Đã đến Egg, đang nhặt..."
                end
            else
                StatusLabel.Text = T("status") .. ": Không thấy Egg"
            end
        end
    end)
end

local function StopAutoSteal()
    S.AutoSteal = false
    if AutoStealConnection then AutoStealConnection:Disconnect() AutoStealConnection = nil end
    StatusLabel.Text = T("status") .. ": " .. T("statusOff")
    StatusLabel.TextColor3 = Color3.fromRGB(150, 160, 165)
end

local AutoStealToggle = Toggle(StealPage, T("autoSteal"), T("autoStealDesc"), function(v)
    if v then StartAutoSteal() else StopAutoSteal() end
end)

