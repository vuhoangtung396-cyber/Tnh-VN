-- Hàm quét Egg chính xác hơn (dùng các Folder Biome cụ thể)
local function ScanEggsInBiome(biomeName)
    local eggs = {}
    -- Tìm Folder Biome trong Workspace
    local biomeFolder = Workspace:FindFirstChild(biomeName)
    if not biomeFolder then
        -- Thử tìm không phân biệt hoa thường
        for _, v in ipairs(Workspace:GetChildren()) do
            if v.Name:lower():find(biomeName:lower()) and v:IsA("Folder") then
                biomeFolder = v
                break
            end
        end
    end
    
    if biomeFolder then
        -- Tìm Egg trong Folder này và các Folder con
        for _, obj in ipairs(biomeFolder:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():find("egg") then
                local eggName = obj.Name
                -- Làm sạch tên để tra cứu
                local cleanName = eggName:gsub("%s+", "_"):gsub("_Egg$", "")
                local data = EggData[cleanName .. "_Egg"] or EggData[eggName:gsub("%s+", "_")]
                
                table.insert(eggs, {
                    name = eggName,
                    biome = biomeName,
                    part = obj,
                    data = data
                })
            end
        end
    end
    return eggs
end

local function ScanAllEggs()
    local allEggs = {}
    local biomes = {"Forest", "Lake", "Desert", "Jungle", "Snow", "Volcano", 
                    "Abyss_Ocean", "Prehistoric", "Cosmic", "Cherry_Blossom", "Titan_Temple"}
    
    for _, biome in ipairs(biomes) do
        local eggs = ScanEggsInBiome(biome)
        for _, egg in ipairs(eggs) do
            table.insert(allEggs, egg)
        end
    end
    return allEggs
end

local function GetEggValueFromData(eggName)
    local cleanName = eggName:gsub("%s+", "_"):gsub("_Egg$", "")
    local data = EggData[cleanName .. "_Egg"]
    if data then
        return data.income, data.rarity, data.pet
    end
    return "?", "?", "?"
end

local function UpdateEggList()
    local eggs = ScanAllEggs()
    if #eggs == 0 then
        EggListText.Text = T("noEggFound") .. "\n(Game có thể lưu Egg ở ServerStorage)"
        return
    end
    
    -- Sắp xếp: Secret lên đầu, sau đó theo giá trị
    table.sort(eggs, function(a, b)
        local aData = a.data or {}
        local bData = b.data or {}
        local aIsSecret = (aData.rarity == "Secret" or aData.rarity == "Mythic" or aData.rarity == "Cosmic") and 1 or 0
        local bIsSecret = (bData.rarity == "Secret" or bData.rarity == "Mythic" or bData.rarity == "Cosmic") and 1 or 0
        if aIsSecret ~= bIsSecret then return aIsSecret > bIsSecret end
        -- So sánh giá trị (chuyển string thành số đơn giản)
        local aVal = tonumber((aData.income or "$0"):gsub("[^%d%.]", "")) or 0
        local bVal = tonumber((bData.income or "$0"):gsub("[^%d%.]", "")) or 0
        return aVal > bVal
    end)
    
    local text = ""
    for i, egg in ipairs(eggs) do
        if i > 15 then text = text .. "\n... và " .. (#eggs - 15) .. " egg khác" break end
        local data = egg.data or {}
        text = text .. "• " .. egg.name .. " | " .. egg.biome .. " | " .. (data.income or "?") .. " | " .. (data.rarity or "?") .. "\n"
    end
    EggListText.Text = text
end

