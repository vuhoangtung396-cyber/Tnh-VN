local function StartFly()
    StopFly()
    local c = LP.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not r or not h then return end
    S.Fly = true

    local bv = Instance.new("BodyVelocity")
    bv.Name = "TnhVN_FlyVelocity"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.P = 25000
    bv.Velocity = Vector3.zero
    bv.Parent = r

    local bg = Instance.new("BodyGyro")
    bg.Name = "TnhVN_FlyGyro"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 30000
    bg.D = 1000
    bg.CFrame = r.CFrame
    bg.Parent = r

    h.PlatformStand = true

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not S.Fly or not r.Parent or not h.Parent then StopFly() return end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local md = h.MoveDirection
        local look = cam.CFrame.LookVector
        local move = Vector3.zero
        if md.Magnitude > 0 then
            local horizontal = Vector3.new(md.X, 0, md.Z)
            if horizontal.Magnitude > 0 then horizontal = horizontal.Unit end
            local vertical = look.Y
            move = Vector3.new(horizontal.X, vertical, horizontal.Z)
            if move.Magnitude > 0 then move = move.Unit end
        end
        bv.Velocity = move * S.FlySpeed
        bg.CFrame = CFrame.lookAt(r.Position, r.Position + look)
    end)
end

