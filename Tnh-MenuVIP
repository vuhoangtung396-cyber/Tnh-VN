TButton.Font = Enum.Font.GothamBold
TButton.Visible = false
TButton.Active = true
TButton.ZIndex = 50
TButton.Parent = Gui
Corner(TButton, 29)
Stroke(TButton, Color3.fromRGB(0, 170, 255), 2)

local TD, TS, TP
TButton.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch
    or i.UserInputType == Enum.UserInputType.MouseButton1 then
        TD = true TS = i.Position TP = TButton.Position
    end
end)
UIS.InputChanged:Connect(function(i)
    if TD and (i.UserInputType == Enum.UserInputType.Touch
    or i.UserInputType == Enum.UserInputType.MouseMovement) then
        local d = i.Position - TS
        TButton.Position = UDim2.new(TP.X.Scale, TP.X.Offset + d.X, TP.Y.Scale, TP.Y.Offset + d.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch
    or i.UserInputType == Enum.UserInputType.MouseButton1 then TD = false end
end)

Min.MouseButton1Click:Connect(function()
    Main.Visible = false Notice.Visible = false TButton.Visible = true
end)
TButton.MouseButton1Click:Connect(function()
    Main.Visible = true Notice.Visible = true TButton.Visible = false
end)

Close.MouseButton1Click:Connect(function()
    StopFly()
    StopSpeed()
    StopAntiHit()
    StopAntiban()
    StopFix()
    StopAutoSteal()
    StopAntiTrap()
    for p in pairs(ESPObjects) do
        if ESPObjects[p] then ESPObjects[p]:Destroy() end
    end
    Gui:Destroy()
end)

OpenPage("Main")
