local function ParseIncome(str)
    if not str then return 0 end
    local num = tonumber((str:gsub("[^%d%.]", ""))) or 0
    local u = str:upper()
    if u:find("K") then num = num * 1e3 end
    if u:find("M") then num = num * 1e6 end
    if u:find("B") then num = num * 1e9 end
    return num
end

local function GetEggInfo(eggName)
    if EggData[eggName] then return EggData[eggName] end
    local low = eggName:lower()
    for k, v in pairs(EggData) do
        if k:lower() == low then return v end
    end
    local noEgg = low:gsub("%s*egg%s*$", "")
    for k, v in pairs(EggData) do
        local kNoEgg = k:lower():gsub("%s*egg%s*$", "")
        if kNoEgg == noEgg then return v end
        if v.pet and v.pet:lower() == noEgg then return v end
    end
    for k, v in pairs(EggData) do
        local kLow = k:lower()
        local petLow = (v.pet or ""):lower()
        if low:find(kLow, 1, true) or kLow:find(low, 1, true) then return v end
        if petLow ~= "" and low:find(petLow, 1, true) then return v end
    end
    return nil
end

local function ScanAllEggs()
    local allEggs, seen = {}, {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not seen[obj] then
            local n = obj.Name:lower()
            if n:find("egg") or n:find("trứng") then
                local anc, isChar = obj.Parent, false
                for _ = 1, 5 do
                    if not anc or anc == Workspace then break end
                    if anc:FindFirstChildOfClass("Humanoid") then isChar = true break end
                    anc = anc.Parent
                end
                if not isChar then
                    seen[obj] = true
                    table.insert(allEggs, {
                        name = obj.Name,
                        part = obj,
                        info = GetEggInfo(obj.Name),
                    })
                end
            end
        end
    end
    return allEggs
end

