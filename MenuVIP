local EggESPTags = {}

local function GetRarityColor(rarity)
    local r = (rarity or ""):lower()
    if r == "secret" then return Color3.fromRGB(255, 30, 30) end
    if r == "divine" or r == "eternal" then return Color3.fromRGB(255, 120, 255) end
    if r == "cosmic" then return Color3.fromRGB(200, 80, 255) end
    if r == "mythic" then return Color3.fromRGB(255, 60, 60) end
    if r == "legendary" then return Color3.fromRGB(255, 200, 50) end
    if r == "epic" then return Color3.fromRGB(200, 100, 255) end
    if r == "rare" then return Color3.fromRGB(80, 180, 255) end
    if r == "uncommon" then return Color3.fromRGB(80, 255, 120) end
    return Color3.fromRGB(255, 255, 255)
end

local function CreateEggTag(part, eggName, info)
    if EggESPTags[part] and EggESPTags[part].Parent then
        local label = EggESPTags[part]:FindFirstChild("Label")
        if label then
            local price = (info and info.income) or "?"
            local rarity = (info and info.rarity) or "?"
            label.Text = (info and info.pet or eggName) .. " — " .. price
            label.TextColor3 = GetRarityColor(rarity)
        end
        return
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TnhVN_EggESP"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 260, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 5000
    billboard.LightInfluence = 0
    billboard.Parent = part

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 17
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextYAlignment = Enum.TextYAlignment.Center

    local price = (info and info.income) or "?"
    local rarity = (info and info.rarity) or "?"
    label.Text = (info and info.pet or eggName) .. " — " .. price
    label.TextColor3 = GetRarityColor(rarity)
    label.Parent = billboard

    EggESPTags[part] = billboard
end

local function ClearEggESP()
    for part, tag in pairs(EggESPTags) do
        if tag then tag:Destroy() end
    end
    EggESPTags = {}
end

local function UpdateEggESP()
    if not S.ESPEgg then
        ClearEggESP()
        return
    end
    local eggs = ScanAllEggs()
    local stillExists = {}
    for _, egg in ipairs(eggs) do
        stillExists[egg.part] = true
        CreateEggTag(egg.part, egg.name, egg.info)
    end
    for part, tag in pairs(EggESPTags) do
        if not stillExists[part] or not part.Parent then
            if tag then tag:Destroy() end
            EggESPTags[part] = nil
        end
    end
end

