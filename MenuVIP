local function TryPickupEgg(eggPart)
    if not eggPart or not eggPart.Parent then return false end

    local prompt = eggPart:FindFirstChildOfClass("ProximityPrompt")
    if not prompt and eggPart.Parent then
        prompt = eggPart.Parent:FindFirstChildOfClass("ProximityPrompt")
    end
    if not prompt then
        for _, d in ipairs(eggPart:GetDescendants()) do
            if d:IsA("ProximityPrompt") then prompt = d break end
        end
    end
    if not prompt and eggPart.Parent then
        for _, d in ipairs(eggPart.Parent:GetDescendants()) do
            if d:IsA("ProximityPrompt") then prompt = d break end
        end
    end
    if prompt then
        pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt, 0)
            else
                prompt:InputHoldBegin()
                task.wait(math.max(prompt.HoldDuration, 0.05) + 0.05)
                prompt:InputHoldEnd()
            end
        end)
        return true
    end

    local cd = eggPart:FindFirstChildOfClass("ClickDetector")
        or (eggPart.Parent and eggPart.Parent:FindFirstChildOfClass("ClickDetector"))
    if cd and fireclickdetector then
        pcall(fireclickdetector, cd)
        return true
    end

    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and firetouchinterest then
        pcall(function()
            firetouchinterest(root, eggPart, 0)
            task.wait(0.05)
            firetouchinterest(root, eggPart, 1)
        end)
        return true
    end
    return false
end

local function UpdateEggList()
    local eggs = ScanAllEggs()
    if #eggs == 0 then
        EggListText.Text = T("noEggFound")
        return
    end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    table.sort(eggs, function(a, b)
        return ParseIncome((a.info or {}).income) > ParseIncome((b.info or {}).income)
    end)

    local text = ""
    for i, egg in ipairs(eggs) do
        if i > 15 then text = text .. "\n... +" .. (#eggs - 15) .. " egg khác" break end
        local info = egg.info or {}
        local dist = root and math.floor((egg.part.Position - root.Position).Magnitude) or 0
        text = text .. "• " .. egg.name
            .. "\n   " .. (info.income or "?") .. " | " .. (info.rarity or "?") .. " | " .. dist .. "m\n"
    end
    EggListText.Text = text
end

