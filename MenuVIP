local function Corner(o, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = o
end
local function Stroke(o, c, t)
    local s = Instance.new("UIStroke"); s.Color = c; s.Thickness = t or 1
    s.Transparency = .35; s.Parent = o
end
local function Label(p, txt, size, pos)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1; l.Text = txt
    l.TextColor3 = Color3.fromRGB(240, 240, 240); l.TextSize = size
    l.Font = Enum.Font.Gotham; l.TextXAlignment = Enum.TextXAlignment.Left
    l.Position = pos; l.ZIndex = 10; l.Parent = p
    return l
end

