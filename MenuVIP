-- AUTO STEAL EGG (TELEPORT)
local AutoStealConnection
local LastPickup = 0

local function FindNearestEgg(prioritySecret)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local all = ScanAllEggs()
    if #all == 0 then return nil end
    local best, bestScore = nil, -math.huge
    for _, egg in ipairs(all) do
        if egg.part and egg.part.Parent then
            local dist = (egg.part.Position - root.Position).Magnitude
            local info = egg.info or {}
            local score = -dist
            if prioritySecret then
                local r = (info.rarity or ""):lower()
                if r == "secret" or r == "mythic" or r == "cosmic"
                or r == "divine" or r == "eternal" then
                    score = score + 1e9
                end
            end
            score = score + ParseIncome(info.income) * 100
            if score > bestScore then bestScore, best = score, egg end
        end
    end
    return best
end

local function StartAutoSteal()
    S.AutoSteal = true
    StatusLabel.Text = T("status") .. ": " .. T("statusOn")
    StatusLabel.TextColor3 = Color3.fromRGB(0, 220, 100)

    if AutoStealConnection then AutoStealConnection:Disconnect() end
    AutoStealConnection = RunService.Heartbeat:Connect(function()
        if not S.AutoSteal then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        local target = FindNearestEgg(S.PrioritySecret)
        if not target then
            StatusLabel.Text = T("status") .. ": Không thấy Egg"
            return
        end

        local pos = target.part.Position
        local info = target.info or {}
        local dist = (pos - root.Position).Magnitude

        StatusLabel.Text = T("status") .. ": → " .. target.name
            .. " (" .. (info.income or "?") .. ") " .. math.floor(dist) .. "m"

        if dist > 5 then
            -- Teleport từng bước 60 studs/frame (không bị Anti Hit/Fly block)
            local dir = pos - root.Position
            local step = math.min(dir.Magnitude - 4, 60)
            local newPos = root.Position + dir.Unit * step
            pcall(function()
                root.CFrame = CFrame.new(newPos + Vector3.new(0, 2.5, 0))
            end)
            root.AssemblyLinearVelocity = Vector3.zero
        else
            local now = tick()
            if now - LastPickup > 0.15 then
                LastPickup = now
                TryPickupEgg(target.part)
            end
        end
    end)
end

local function StopAutoSteal()
    S.AutoSteal = false
    if AutoStealConnection then AutoStealConnection:Disconnect() AutoStealConnection = nil end
    StatusLabel.Text = T("status") .. ": " .. T("statusOff")
    StatusLabel.TextColor3 = Color3.fromRGB(150, 160, 165)
end

