-- AUTO STEAL EGG (FIXED - không lag, nhặt thật)
-- ==================================================
local AutoStealConnection
local LastPickupAttempt = 0
local CARRY_IMMUNE_FORCE = nil
local teleportDistance = 50
local lastScanTime = 0
local cachedEggs = {}
local SCAN_CACHE_TIME = 0.8  -- cache kết quả scan 0.8s

-- Cache scan để tránh scan liên tục
local function GetCachedEggs(radius)
    local now = tick()
    if now - lastScanTime > SCAN_CACHE_TIME or #cachedEggs == 0 then
        cachedEggs = ScanAllEggs(radius)
        lastScanTime = now
    end
    return cachedEggs
end

local function FirePrompt(prompt)
    if not prompt then return false end
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt, 0)
        else
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
        end
    end)
    return true
end

local function FindNearestEgg()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local allEggs = GetCachedEggs(500)
    if #allEggs == 0 then
        -- Nếu không có trong 500m -> scan toàn bộ
        allEggs = ScanAllEggs()
        cachedEggs = allEggs
        lastScanTime = tick()
    end
    if #allEggs == 0 then return nil end

    local bestEgg, bestScore = nil, -math.huge
    for _, egg in ipairs(allEggs) do
        if egg.part and egg.part.Parent and EggMatchesPriority(egg) then
            local dist = (egg.part.Position - root.Position).Magnitude
            local info = egg.info or {}
            local score = -dist
            if S.PrioritySecret then
                local r = (info.rarity or ""):lower()
                if r == "secret" or r == "mythic" or r == "cosmic"
                or r == "divine" or r == "eternal" then
                    score = score + 1e9
                end
            end
            score = score + ParseIncome(info.income) * 100
            if score > bestScore then bestScore, bestEgg = score, egg end
        end
    end
    return bestEgg
end

local function EnableCarryImmune()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, st in ipairs(NO_STATES) do
            pcall(function() hum:SetStateEnabled(st, false) end)
        end
    end
    if not CARRY_IMMUNE_FORCE or CARRY_IMMUNE_FORCE.Parent ~= char then
        if CARRY_IMMUNE_FORCE then CARRY_IMMUNE_FORCE:Destroy() end
        CARRY_IMMUNE_FORCE = Instance.new("ForceField")
        CARRY_IMMUNE_FORCE.Name = "TnhVN_CarryImmune"
        CARRY_IMMUNE_FORCE.Visible = false
        CARRY_IMMUNE_FORCE.Parent = char
    end
end

local function DisableCarryImmune()
    if CARRY_IMMUNE_FORCE then CARRY_IMMUNE_FORCE:Destroy() CARRY_IMMUNE_FORCE = nil end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and not S.AntiHit then
        for _, st in ipairs(NO_STATES) do
            pcall(function() hum:SetStateEnabled(st, true) end)
        end
    end
end

local function StartAutoSteal()
    S.AutoSteal = true
    StatusLabel.Text = T("status") .. ": " .. T("statusOn")
    StatusLabel.TextColor3 = Color3.fromRGB(0, 220, 100)
    FindBasePosition()

    if AutoStealConnection then AutoStealConnection:Disconnect() end
    AutoStealConnection = RunService.Heartbeat:Connect(function()
        if not S.AutoSteal then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        -- Đang cầm trứng → về Base
        if IsCarryingEgg() then
            EnableCarryImmune()
            if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
            local base = FindBasePosition()
            local dist = (base - root.Position).Magnitude
            StatusLabel.Text = T("status") .. ": Đang mang về Base... (" .. math.floor(dist) .. "m)"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
            if dist > 8 then
                local dir = base - root.Position
                local step = math.min(dir.Magnitude - 4, 80)
                local newPos = root.Position + dir.Unit * step
                pcall(function()
                    root.CFrame = CFrame.new(newPos + Vector3.new(0, 2.5, 0))
                end)
                root.AssemblyLinearVelocity = Vector3.zero
            else
                StatusLabel.Text = T("status") .. ": Đã về Base!"
                StatusLabel.TextColor3 = Color3.fromRGB(0, 220, 100)
            end
            return
        else
            DisableCarryImmune()
        end

        -- Chưa cầm → tìm trứng
        local target = FindNearestEgg()
        if not target then
            StatusLabel.Text = T("status") .. ": Không có trứng match"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end

        local pos = target.part.Position
        local dist = (pos - root.Position).Magnitude
        local info = target.info or {}
        local nameDisplay = target.realName or target.name
        StatusLabel.Text = T("status") .. ": → " .. nameDisplay
            .. " (" .. (info.income or "?") .. ") " .. math.floor(dist) .. "m"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)

        -- Gần trứng → nhặt
        if dist <= 10 then
            local now = tick()
            if now - LastPickupAttempt > 0.15 then
                LastPickupAttempt = now
                local prompt = target.part:FindFirstChildOfClass("ProximityPrompt")
                if not prompt and target.part.Parent then
                    prompt = target.part.Parent:FindFirstChildOfClass("ProximityPrompt")
                end
                if not prompt then
                    for _, d in ipairs(target.part:GetDescendants()) do
                        if d:IsA("ProximityPrompt") then prompt = d break end
                    end
                end
                if prompt then FirePrompt(prompt) end
            end
            root.AssemblyLinearVelocity = Vector3.zero
        else
            -- Teleport lại gần trứng
            local dir = pos - root.Position
            local step = math.min(dir.Magnitude - 5, teleportDistance)
            local newPos = root.Position + dir.Unit * step
            pcall(function()
                root.CFrame = CFrame.new(newPos + Vector3.new(0, 2.5, 0))
            end)
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

local function StopAutoSteal()
    S.AutoSteal = false
    if AutoStealConnection then
        AutoStealConnection:Disconnect()
        AutoStealConnection = nil
    end
    DisableCarryImmune()
    cachedEggs = {}
    StatusLabel.Text = T("status") .. ": " .. T("statusOff")
    StatusLabel.TextColor3 = Color3.fromRGB(150, 160, 165)
end

