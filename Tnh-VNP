local function GetRarityColor(rarity)
    local r=(rarity or ""):lower()
    if r=="secret" then return Color3.fromRGB(255,30,30) end
    if r=="divine" or r=="eternal" then return Color3.fromRGB(255,120,255) end
    if r=="cosmic" then return Color3.fromRGB(200,80,255) end
    if r=="mythic" then return Color3.fromRGB(255,60,60) end
    if r=="legendary" then return Color3.fromRGB(255,200,50) end
    if r=="epic" then return Color3.fromRGB(200,100,255) end
    if r=="rare" then return Color3.fromRGB(80,180,255) end
    if r=="uncommon" then return Color3.fromRGB(80,255,120) end
    return Color3.fromRGB(255,255,255)
end

local function CreateEggTag(part, eggName, info, gameText)
    local labelText
    if info and info.pet then
        labelText = info.pet .. " — " .. (info.income or "?")
    elseif gameText and gameText ~= "" then
        labelText = gameText
    else
        labelText = eggName .. " — ?"
    end
    local color = GetRarityColor(info and info.rarity)

    if EggESPTags[part] and EggESPTags[part].Parent then
        local label = EggESPTags[part]:FindFirstChild("Label")
        if label then
            label.Text = labelText
            label.TextColor3 = color
        end
        return
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name="TnhVN_EggESP"; billboard.Adornee=part
    billboard.Size=UDim2.new(0,220,0,36)
    billboard.StudsOffset=Vector3.new(0,3.5,0)
    billboard.AlwaysOnTop=true
    billboard.MaxDistance=ESP_SCAN_RADIUS
    billboard.LightInfluence=0
    billboard.Parent=part

    local label = Instance.new("TextLabel")
    label.Name="Label"; label.BackgroundTransparency=1
    label.Size=UDim2.new(1,0,1,0); label.Font=Enum.Font.GothamBold
    label.TextSize=15; label.TextStrokeTransparency=0
    label.TextStrokeColor3=Color3.new(0,0,0)
    label.TextXAlignment=Enum.TextXAlignment.Center
    label.TextYAlignment=Enum.TextYAlignment.Center
    label.Text = labelText; label.TextColor3 = color
    label.Parent = billboard
    EggESPTags[part] = billboard
end

local function ClearEggESP()
    for part,tag in pairs(EggESPTags) do
        if tag then tag:Destroy() end
    end
    EggESPTags = {}
end

local function UpdateEggESP()
    if not S.ESPEgg then ClearEggESP(); return end
    local eggs = ScanAllEggs(ESP_SCAN_RADIUS)
    local still = {}
    for _, egg in ipairs(eggs) do
        still[egg.part] = true
        CreateEggTag(egg.part, egg.realName, egg.info, egg.gameText)
    end
    for part,tag in pairs(EggESPTags) do
        if not still[part] or not part.Parent then
            if tag then tag:Destroy() end
            EggESPTags[part] = nil
        end
    end
end

