local AntiHitConnection,AntiHitForce,AntiHitLoop,AntiHitGyro
local NO_STATES={
    Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.FallingDown,
    Enum.HumanoidStateType.Physics,
    Enum.HumanoidStateType.PlatformStanding,
}

local function ApplyAntiHit()
    local c=LP.Character
    local h=c and c:FindFirstChildOfClass("Humanoid")
    if not c or not h then return end
    for _,st in ipairs(NO_STATES) do
        pcall(function() h:SetStateEnabled(st,false) end)
    end
    if AntiHitForce and AntiHitForce.Parent~=c then AntiHitForce=nil end
    if not AntiHitForce then
        AntiHitForce=Instance.new("ForceField")
        AntiHitForce.Name="TnhVN_AntiHit"; AntiHitForce.Visible=false
        AntiHitForce.Parent=c
    end
    local root=c:FindFirstChild("HumanoidRootPart")
    if root then
        if AntiHitGyro and AntiHitGyro.Parent~=root then AntiHitGyro=nil end
        if not AntiHitGyro then
            AntiHitGyro=Instance.new("BodyGyro")
            AntiHitGyro.Name="TnhVN_AntiHitGyro"
            AntiHitGyro.MaxTorque=Vector3.new(1e6,1e6,1e6)
            AntiHitGyro.P=50000; AntiHitGyro.D=1000
            AntiHitGyro.CFrame=root.CFrame; AntiHitGyro.Parent=root
        end
    end
    if AntiHitLoop then AntiHitLoop:Disconnect() end
    AntiHitLoop=RunService.Heartbeat:Connect(function()
        if not S.AntiHit then return end
        if S.AutoSteal or S.Fly then return end
        local char=LP.Character
        if not char then return end
        local hum=char:FindFirstChildOfClass("Humanoid")
        local rt=char:FindFirstChild("HumanoidRootPart")
        if not hum or not rt then return end
        if hum.Health<hum.MaxHealth then hum.Health=hum.MaxHealth end
        hum.PlatformStand=false; hum.Sit=false; hum.AutoRotate=true
        local st=hum:GetState()
        if st==Enum.HumanoidStateType.Ragdoll
        or st==Enum.HumanoidStateType.FallingDown
        or st==Enum.HumanoidStateType.Physics
        or st==Enum.HumanoidStateType.PlatformStanding then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        local vel=rt.AssemblyLinearVelocity
        rt.AssemblyLinearVelocity=Vector3.new(0,vel.Y,0)
        rt.AssemblyAngularVelocity=Vector3.zero
        if AntiHitGyro and AntiHitGyro.Parent==rt then
            local _,yaw=rt.CFrame:ToEulerAnglesYXZ()
            AntiHitGyro.CFrame=CFrame.new(rt.Position)*CFrame.Angles(0,yaw,0)
        end
    end)
end

local function StopAntiHit()
    if AntiHitConnection then AntiHitConnection:Disconnect() AntiHitConnection=nil end
    if AntiHitLoop then AntiHitLoop:Disconnect() AntiHitLoop=nil end
    if AntiHitForce then AntiHitForce:Destroy() AntiHitForce=nil end
    if AntiHitGyro then AntiHitGyro:Destroy() AntiHitGyro=nil end
    local c=LP.Character
    local h=c and c:FindFirstChildOfClass("Humanoid")
    if h then
        for _,st in ipairs(NO_STATES) do
            pcall(function() h:SetStateEnabled(st,true) end)
        end
    end
end

local function StartAntiHit()
    StopAntiHit(); S.AntiHit=true; ApplyAntiHit()
    AntiHitConnection=LP.CharacterAdded:Connect(function()
        task.wait(.5)
        if S.AntiHit then ApplyAntiHit() end
    end)
end

