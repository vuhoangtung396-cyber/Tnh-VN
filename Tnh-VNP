local function ParseIncome(str)
    if not str then return 0 end
    local num=tonumber((str:gsub("[^%d%.]",""))) or 0
    local u=str:upper()
    if u:find("K") then num=num*1e3 end
    if u:find("M") then num=num*1e6 end
    if u:find("B") then num=num*1e9 end
    return num
end

local function GetEggInfo(eggName)
    if not eggName or eggName=="" then return nil end
    if EggData[eggName] then return EggData[eggName] end
    if EggData[eggName.." Egg"] then return EggData[eggName.." Egg"] end
    local low=eggName:lower()
    for k,v in pairs(EggData) do
        if k:lower()==low then return v end
    end
    for k,v in pairs(EggData) do
        if v.pet and v.pet:lower()==low then return v end
    end
    local noEgg=low:gsub("%s*egg%s*$","")
    for k,v in pairs(EggData) do
        local kNoEgg=k:lower():gsub("%s*egg%s*$","")
        if kNoEgg==noEgg then return v end
    end
    for k,v in pairs(EggData) do
        local kLow=k:lower()
        local petLow=(v.pet or ""):lower()
        if #low>3 and low:find(kLow,1,true) then return v end
        if petLow~="" and low:find(petLow,1,true) then return v end
        if petLow~="" and petLow:find(low,1,true) and #low>3 then return v end
    end
    return nil
end

local function ReadGameLabel(part)
    local target = part
    for depth=1,5 do
        if not target then break end
        for _, d in ipairs(target:GetDescendants()) do
            if d:IsA("BillboardGui") and d.Name ~= "TnhVN_EggESP" then
                for _, t in ipairs(d:GetDescendants()) do
                    if t:IsA("TextLabel") and t.Text ~= "" then
                        local txt = t.Text
                        local petName, price = txt:match("^(.-)%s*[—%-–]%s*(%$[%d%.,]+[KMB]?/?s?)$")
                        if petName and price then
                            return petName:gsub("^%s+",""):gsub("%s+$",""), price
                        end
                        local pn = txt:match("^(.-)%s*[—%-–]")
                        if pn and #pn > 1 and #pn < 40 then
                            return pn:gsub("^%s+",""):gsub("%s+$",""), txt
                        end
                    end
                end
            end
        end
        target = target.Parent
    end
    return nil, nil
end

local function ReadAttributeName(part)
    local target = part
    for depth=1,3 do
        if not target then break end
        for _, attrName in ipairs({"EggName","PetName","EggType","PetType","Name","Type","Pet","DisplayName"}) do
            local ok, v = pcall(function() return target:GetAttribute(attrName) end)
            if ok and typeof(v)=="string" and #v>1 and #v<40 then return v end
        end
        for _, c in ipairs(target:GetChildren()) do
            if c:IsA("StringValue") and #c.Value>1 and #c.Value<40 then
                return c.Value
            end
        end
        target = target.Parent
    end
    return nil
end

local function ScanAllEggs(radius)
    local allEggs, seen = {}, {}
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = root and root.Position

    local candidates = {}
    if radius and myPos then
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = char and {char} or {}
        local ok, parts = pcall(function()
            return Workspace:GetPartBoundsInRadius(myPos, radius, params)
        end)
        if ok and parts then candidates = parts end
    else
        candidates = Workspace:GetDescendants()
    end

    for _, obj in ipairs(candidates) do
        if obj:IsA("BasePart") and not seen[obj] then
            local n = obj.Name:lower()
            if n:find("egg") or n:find("trứng") then
                local anc, isChar = obj.Parent, false
                for _=1,5 do
                    if not anc or anc==Workspace then break end
                    if anc:FindFirstChildOfClass("Humanoid") then isChar=true break end
                    anc = anc.Parent
                end
                if not isChar then
                    seen[obj] = true
                    local realName, gameText = ReadGameLabel(obj)
                    if not realName then realName = ReadAttributeName(obj) end
                    if not realName or realName == "" then realName = obj.Name end
                    local info = GetEggInfo(realName)
                    table.insert(allEggs, {
                        name = obj.Name,
                        realName = realName,
                        part = obj,
                        info = info,
                        gameText = gameText,
                    })
                end
            end
        end
    end
    return allEggs
end

