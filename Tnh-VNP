local FixHeader=PageHeader(FixPage,"FixLag","Performance utilities")
local Saved={}
local FixConnection
local function DisableEffect(o)
    if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Smoke")
    or o:IsA("Fire") or o:IsA("Sparkles") or o:IsA("PointLight")
    or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
        if Saved[o]==nil then Saved[o]=o.Enabled end
        pcall(function() o.Enabled=false end)
    end
    if o:IsA("BasePart") then
        if Saved[o]==nil then Saved[o]={CastShadow=o.CastShadow,Material=o.Material} end
        pcall(function()
            o.CastShadow=false
            if o.Material~=Enum.Material.Water then o.Material=Enum.Material.Plastic end
        end)
    end
end
local function StartFix()
    S.FixLag=true
    for _,o in ipairs(Workspace:GetDescendants()) do DisableEffect(o) end
    pcall(function()
        Saved.GlobalShadows=Lighting.GlobalShadows; Lighting.GlobalShadows=false
        Saved.EnvironmentDiffuseScale=Lighting.EnvironmentDiffuseScale; Lighting.EnvironmentDiffuseScale=0
        Saved.EnvironmentSpecularScale=Lighting.EnvironmentSpecularScale; Lighting.EnvironmentSpecularScale=0
        Saved.Brightness=Lighting.Brightness; Lighting.Brightness=1
    end)
    pcall(function()
        if Workspace.Terrain then
            Saved.WaterWaveSize=Workspace.Terrain.WaterWaveSize; Workspace.Terrain.WaterWaveSize=0
            Saved.WaterWaveSpeed=Workspace.Terrain.WaterWaveSpeed; Workspace.Terrain.WaterWaveSpeed=0
            Saved.WaterReflectance=Workspace.Terrain.WaterReflectance; Workspace.Terrain.WaterReflectance=0
        end
    end)
    FixConnection=Workspace.DescendantAdded:Connect(function(o)
        if S.FixLag then DisableEffect(o) end
    end)
end
local function StopFix()
    S.FixLag=false
    if FixConnection then FixConnection:Disconnect() FixConnection=nil end
    for o,v in pairs(Saved) do
        if typeof(o)=="Instance" and o.Parent then
            pcall(function()
                if v.CastShadow~=nil then o.CastShadow=v.CastShadow end
                if v.Material~=nil then o.Material=v.Material end
                if v==true or v==false then o.Enabled=v end
            end)
        end
    end
    pcall(function()
        if Saved.GlobalShadows~=nil then Lighting.GlobalShadows=Saved.GlobalShadows end
        if Saved.EnvironmentDiffuseScale~=nil then Lighting.EnvironmentDiffuseScale=Saved.EnvironmentDiffuseScale end
        if Saved.EnvironmentSpecularScale~=nil then Lighting.EnvironmentSpecularScale=Saved.EnvironmentSpecularScale end
        if Saved.Brightness~=nil then Lighting.Brightness=Saved.Brightness end
    end)
    Saved={}
end
local XT=Toggle(FixPage,T("fixlag"),T("fixlagDesc"),function(v)
    if v then StartFix() else StopFix() end
end)

