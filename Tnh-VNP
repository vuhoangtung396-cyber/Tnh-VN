local function ReloadPriorityList()
    for name, data in pairs(PriorityButtons) do
        if data.Button then data.Button:Destroy() end
    end
    PriorityButtons = {}

    local allEggs = ScanAllEggs()
    local uniqueNames = {}
    for _, egg in ipairs(allEggs) do
        local key = egg.realName or egg.name
        if not uniqueNames[key] and GetEggInfo(key) then
            uniqueNames[key] = egg.info
        end
    end

    if not next(uniqueNames) then
        local noEgg = Instance.new("TextLabel")
        noEgg.Size = UDim2.new(1, -10, 0, 30)
        noEgg.BackgroundTransparency = 1
        noEgg.Text = "Không có trứng nào trong server"
        noEgg.TextColor3 = Color3.fromRGB(200, 100, 100)
        noEgg.TextSize = 12
        noEgg.Font = Enum.Font.Gotham
        noEgg.Parent = PriorityScroll
        PriorityButtons["__empty"] = {Button = noEgg}
        ReloadBtn.Text = "🔄 Loading Egg"
        return
    end

    local sorted = {}
    for name, info in pairs(uniqueNames) do
        table.insert(sorted, {name = name, info = info})
