    b.BackgroundColor3=Color3.fromRGB(0,150,215); b.Text="EXECUTE"
    b.TextColor3=Color3.new(1,1,1); b.TextSize=13
    b.Font=Enum.Font.GothamBold; b.Active=true; b.ZIndex=15; b.Parent=r
    Corner(b,9)
    b.MouseButton1Click:Connect(function()
        b.Text="LOADING..."
        task.spawn(function()
            local ok,err=pcall(function()
                local code=game:HttpGet(url)
                local fn=loadstring(code)
                if fn then fn() else error("loadstring failed") end
            end)
            if ok then
                b.Text="EXECUTED"; task.wait(1); b.Text="EXECUTE"
