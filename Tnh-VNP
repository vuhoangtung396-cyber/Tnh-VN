function OpenPage(name)
    for n,p in pairs(Pages) do p.Visible=(n==name) end
    for n,b in pairs(Buttons) do
        b.BackgroundColor3=n==name and Color3.fromRGB(0,150,215) or Color3.fromRGB(29,36,40)
    end
end

