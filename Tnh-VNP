local CachedBase = nil
local function FindBasePosition()
    if CachedBase then return CachedBase end
    for _, o in ipairs(Workspace:GetDescendants()) do
        if o:IsA("SpawnLocation") then
            CachedBase = o.Position
            return CachedBase
        end
    end
    local lname = LP.Name:lower()
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("Model") or o:IsA("Folder") then
            if o.Name:lower():find(lname, 1, true) then
                local p = o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
                if p then CachedBase = p.Position; return CachedBase end
            end
        end
    end
    for _, folderName in ipairs({"Bases","Pens","Base","Spawns","Plots"}) do
        local f = Workspace:FindFirstChild(folderName)
        if f then
            for _, o in ipairs(f:GetChildren()) do
                if o.Name:lower():find(lname, 1, true) then
                    local p = o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
                    if p then CachedBase = p.Position; return CachedBase end
                end
            end
        end
    end
    return Vector3.new(0, 50, 0)
end

local function IsCarryingEgg()
    for _, a in ipairs({"HasEgg","CarryingEgg","HasPet","CarryEgg","Holding","IsCarrying","Egg","EggName","Carrying"}) do
        local ok, v = pcall(function() return LP:GetAttribute(a) end)
        if ok and v ~= nil and v ~= false and v ~= "" then return true end
    end
    local char = LP.Character
    if char then
        for _, o in ipairs(char:GetChildren()) do
            local n = o.Name:lower()
            if (n:find("egg") or n:find("carry") or n:find("hold")) and not o:IsA("Humanoid") then
                return true
            end
        end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _, o in ipairs(bp:GetChildren()) do
            if o.Name:lower():find("egg") then return true end
        end
    end
    return false
end

local function EggMatchesPriority(egg)
    if not next(S.PriorityEggs) then return true end
    local candidates = {}
    if egg.realName then table.insert(candidates, egg.realName:lower()) end
    if egg.name then table.insert(candidates, egg.name:lower()) end
    if egg.info and egg.info.pet then table.insert(candidates, egg.info.pet:lower()) end
    for prioName, _ in pairs(S.PriorityEggs) do
        local p = prioName:lower()
        local pNoEgg = p:gsub("%s*egg%s*$", "")
        for _, c in ipairs(candidates) do
            local cNoEgg = c:gsub("%s*egg%s*$", "")
            if c == p or c == pNoEgg or cNoEgg == p or cNoEgg == pNoEgg then
                return true
            end
        end
    end
    return false
end

