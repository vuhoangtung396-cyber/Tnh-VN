local isLagFixed = false
fixLagToggle.MouseButton1Click:Connect(function()
	isLagFixed = not isLagFixed
	if isLagFixed then
		fixLagToggle.Text = "ON"
		fixLagToggle.BackgroundColor3 = Color3.fromRGB(0, 162, 232)
		
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		Lighting.GlobalShadows = false
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("Clouds") or v:IsA("Atmosphere") or v:IsA("PostEffect") then
				v.Enabled = false
			end
		end
		for _, v in ipairs(workspace:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CastShadow = false
				v.Material = Enum.Material.SmoothPlastic
			elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
				v.Enabled = false
			end
		end
	else
		fixLagToggle.Text = "OFF"
		fixLagToggle.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	end
end)

