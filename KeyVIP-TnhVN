local FixHeader=PageHeader(
 FixPage,
 "FixLag",
 "Performance utilities"
)

local Saved={}
local FixConnection

local function DisableEffect(o)
 if o:IsA("ParticleEmitter")
 or o:IsA("Trail")
 or o:IsA("Beam")
 or o:IsA("Smoke")
 or o:IsA("Fire")
 or o:IsA("Sparkles")then

  if Saved[o]==nil then
   Saved[o]=o.Enabled
  end

  pcall(function()
   o.Enabled=false
  end)
 end
end

local function StartFix()
 S.FixLag=true

 for _,o in ipairs(Workspace:GetDescendants())do
  DisableEffect(o)
 end

 Saved.GlobalShadows=Lighting.GlobalShadows
 Lighting.GlobalShadows=false

 FixConnection=Workspace.DescendantAdded:Connect(function(o)
  if S.FixLag then
   DisableEffect(o)
  end
 end)
end

local function StopFix()
 S.FixLag=false

 if FixConnection then
  FixConnection:Disconnect()
  FixConnection=nil
 end

 for o,v in pairs(Saved)do
  if typeof(o)=="Instance" and o.Parent then
   pcall(function()
    o.Enabled=v
   end)
  end
 end

 if Saved.GlobalShadows~=nil then
  Lighting.GlobalShadows=Saved.GlobalShadows
 end

 Saved={}
end

