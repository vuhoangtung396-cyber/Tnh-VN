-- ANTI HIT
local AntiHitConnection
local AntiHitForce

local function ApplyAntiHit()
 local c=LP.Character
 local h=c and c:FindFirstChildOfClass("Humanoid")

 if not c or not h then
  return
 end

 if AntiHitForce and AntiHitForce.Parent~=c then
  AntiHitForce=nil
 end

 if not AntiHitForce then
  AntiHitForce=Instance.new("ForceField")
  AntiHitForce.Name="TnhVN_AntiHit"
  AntiHitForce.Visible=false
  AntiHitForce.Parent=c
 end
end

local function StopAntiHit()
 if AntiHitConnection then
  AntiHitConnection:Disconnect()
  AntiHitConnection=nil
 end

 if AntiHitForce then
  AntiHitForce:Destroy()
  AntiHitForce=nil
 end
end

local function StartAntiHit()
 StopAntiHit()

 S.AntiHit=true
 ApplyAntiHit()

 AntiHitConnection=LP.CharacterAdded:Connect(function()
  task.wait(.5)

  if S.AntiHit then
   ApplyAntiHit()
  end
 end)
end

local AHT=Toggle(
 MainPage,
 T("antiHit"),
 T("antiHitDesc"),
 function(v)
  if v then
   StartAntiHit()
  else
   S.AntiHit=false
   StopAntiHit()
  end
 end
)

