-- Auto Steal Egg
local AutoStealConnection
local AutoStealTarget=nil

local function FindNearestEgg(prioritySecret)
 local char=LP.Character
 local root=char and char:FindFirstChild("HumanoidRootPart")
 if not root then return nil end

 local best=nil
 local bestDist=math.huge
 for _,obj in ipairs(Workspace:GetDescendants())do
  if obj:IsA("BasePart") and obj.Name:lower():find("egg") then
   -- Nếu ưu tiên Secret, ưu tiên khoảng cách nhưng check tên
   local dist=(obj.Position-root.Position).Magnitude
   local isSecret=obj.Name:lower():find("secret") and true or false
   if prioritySecret and isSecret then
    -- Secret luôn được ưu tiên bất kể khoảng cách
    if isSecret and (not best or not best.Name:lower():find("secret")) then
     best=obj bestDist=dist
    elseif isSecret and dist<bestDist then
     best=obj bestDist=dist
    end
   else
    if dist<bestDist then best=obj bestDist=dist end
   end
  end
 end
 return best
end

local function StartAutoSteal()
 S.AutoSteal=true
 StatusLabel.Text=T("status")..": "..T("statusOn")
 StatusLabel.TextColor3=Color3.fromRGB(0,220,100)

 if AutoStealConnection then AutoStealConnection:Disconnect() end

 AutoStealConnection=RunService.Heartbeat:Connect(function()
  if not S.AutoSteal then return end
  local char=LP.Character
  local root=char and char:FindFirstChild("HumanoidRootPart")
  local hum=char and char:FindFirstChildOfClass("Humanoid")
  if not root or not hum then return end

  local target=FindNearestEgg(S.PrioritySecret)

  if target then
   StatusLabel.Text=T("status")..": → "..target.Name.." ("..GetEggValue(target.Name)..")"
   -- Di chuyển về phía Egg (không teleport)
   local dir=(target.Position-root.Position)
   if dir.Magnitude>3 then
    local move=dir.Unit
    -- Dùng MoveDirection để không bị anti-cheat
    hum:Move(move,false)
   end
  else
   StatusLabel.Text=T("status")..": Không thấy Egg"
  end
 end)
end

local function StopAutoSteal()
 S.AutoSteal=false
 if AutoStealConnection then AutoStealConnection:Disconnect() AutoStealConnection=nil end
 StatusLabel.Text=T("status")..": "..T("statusOff")
 StatusLabel.TextColor3=Color3.fromRGB(150,160,165)
end

