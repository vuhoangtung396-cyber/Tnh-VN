-- Bảng giá trị Egg (dựa trên game Steal An Egg)
local EggValueMap={
 chicken="$1/s", dog="$2/s", frog="$3/s", duckling="$4/s",
 bunny="$5/s", jerboa="$6/s", bird="$8/s", catfish="$12/s",
 fennec="$18/s", dragon="$50/s", secret="???"
}

local function GetEggValue(name)
 local ln=name:lower()
 for k,v in pairs(EggValueMap)do
  if ln:find(k) then return v end
 end
 return "?"
end

local function ScanEggs()
 local eggs={}
 for _,obj in ipairs(Workspace:GetDescendants())do
  if obj:IsA("BasePart") and obj.Name:lower():find("egg") then
   local biome="Unknown"
   local parent=obj.Parent
   while parent do
    local pn=parent.Name:lower()
    if pn:find("forest") then biome="Forest" break
    elseif pn:find("lake") then biome="Lake" break
    elseif pn:find("desert") then biome="Desert" break
    elseif pn:find("jungle") then biome="Jungle" break
    elseif pn:find("snow") then biome="Snow" break
    elseif pn:find("volcano") then biome="Volcano" break
    elseif pn:find("cave") then biome="Cave" break
    elseif pn:find("heaven") then biome="Heaven" break
    end
    parent=parent.Parent
   end
   table.insert(eggs,{
    name=obj.Name, biome=biome,
    value=GetEggValue(obj.Name), part=obj
   })
  end
 end
 return eggs
end

local function UpdateEggList()
 local eggs=ScanEggs()
 if #eggs==0 then
  EggListText.Text="Không tìm thấy Egg trong Workspace.\n(Game có thể lưu Egg ở ServerStorage)"
  return
 end
 -- Sort: Secret lên đầu
 table.sort(eggs,function(a,b)
  local as=a.name:lower():find("secret") and 1 or 0
  local bs=b.name:lower():find("secret") and 1 or 0
  return as>bs
 end)
 local text=""
 for i,egg in ipairs(eggs)do
  if i>10 then text=text.."\n... và "..(#eggs-10).." egg khác" break end
  text=text.."• "..egg.name.." | "..egg.biome.." | "..egg.value.."\n"
 end
 EggListText.Text=text
end

-- Auto scan mỗi 5s khi trang mở
task.spawn(function()
 while task.wait(5)do
  if StealPage.Visible then pcall(UpdateEggList) end
 end
end)

