local TrapConnection
local DisabledTraps={}

local function StartAntiTrap()
 S.AntiTrap=true
 if TrapConnection then TrapConnection:Disconnect() end

 -- Quét trap hiện tại
 local function disableTrap(o)
  if not o:IsA("BasePart") then return end
  local n=o.Name:lower()
  if n:find("trap") or n:find("bẫy") or n:find("spike") or n:find("bear") then
   DisabledTraps[o]={CanCollide=o.CanCollide,CanTouch=o.CanTouch}
   pcall(function()
    o.CanCollide=false
    o.CanTouch=false
   end)
  end
 end

 for _,o in ipairs(Workspace:GetDescendants())do disableTrap(o) end

 TrapConnection=Workspace.DescendantAdded:Connect(function(o)
  if S.AntiTrap then disableTrap(o) end
 end)
end

local function StopAntiTrap()
 S.AntiTrap=false
 if TrapConnection then TrapConnection:Disconnect() TrapConnection=nil end
 for o,v in pairs(DisabledTraps)do
  if o.Parent then
   pcall(function()
    o.CanCollide=v.CanCollide
    o.CanTouch=v.CanTouch
   end)
  end
 end
 DisabledTraps={}
end

