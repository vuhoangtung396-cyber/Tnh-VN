TButton.Parent=Gui
Corner(TButton,29)
Stroke(TButton,Color3.fromRGB(0,170,255),2)

local TD,TS,TP
TButton.InputBegan:Connect(function(i)
 if i.UserInputType==Enum.UserInputType.Touch
 or i.UserInputType==Enum.UserInputType.MouseButton1 then
  TD=true TS=i.Position TP=TButton.Position
 end
end)
UIS.InputChanged:Connect(function(i)
 if TD and (i.UserInputType==Enum.UserInputType.Touch
 or i.UserInputType==Enum.UserInputType.MouseMovement) then
  local d=i.Position-TS
  TButton.Position=UDim2.new(TP.X.Scale,TP.X.Offset+d.X,TP.Y.Scale,TP.Y.Offset+d.Y)
 end
end)
UIS.InputEnded:Connect(function(i)
 if i.UserInputType==Enum.UserInputType.Touch
 or i.UserInputType==Enum.UserInputType.MouseButton1 then TD=false end
end)

