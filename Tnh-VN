local ESPObjects={}
local function AddESP(p)
 if p==LP or ESPObjects[p] or not p.Character then return end
 local h=Instance.new("Highlight")
 h.Name="TnhVN_ESP"
 h.Adornee=p.Character
 h.FillColor=S.ESPColor
 h.OutlineColor=S.ESPColor
 h.FillTransparency=.78
 h.OutlineTransparency=0
 h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
 h.Parent=p.Character
 ESPObjects[p]=h
end

local function UpdateESP()
 for _,p in ipairs(Players:GetPlayers())do
  if p~=LP then
   if S.ESP then
    AddESP(p)
    if ESPObjects[p]then
     ESPObjects[p].Enabled=true
     ESPObjects[p].FillColor=S.ESPColor
     ESPObjects[p].OutlineColor=S.ESPColor
    end
   elseif ESPObjects[p]then
    ESPObjects[p].Enabled=false
   end
  end
 end
end

Players.PlayerAdded:Connect(function(p)
 p.CharacterAdded:Connect(function()
  task.wait(.5)
  if S.ESP then AddESP(p) end
 end)
end)
Players.PlayerRemoving:Connect(function(p)
 if ESPObjects[p] then ESPObjects[p]:Destroy() ESPObjects[p]=nil end
end)

local ET=Toggle(MainPage,T("esp"),T("espDesc"),function(v)
 S.ESP=v
 UpdateESP()
end)

